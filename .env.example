DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=0

# Optional SMTP settings. Without SMTP_HOST, OTP messages are printed by the dev server.
# SMTP_HOST=smtp.example.com
# Port 587 uses STARTTLS; port 465 uses implicit TLS. Gmail requires an App Password.
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=no-reply@example.com
